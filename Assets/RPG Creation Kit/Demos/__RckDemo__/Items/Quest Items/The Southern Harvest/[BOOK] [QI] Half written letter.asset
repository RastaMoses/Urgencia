  openedCoverSprite: {fileID: 21300000, guid: f9f6ef615ea10cf47acc9940bde21fa6, type: 3}
  BookText: "Mack, \n\nI don't know if you will ever find and read this, we didn't
    had any news from you whitin the times we set, so we presume something went wrong.\n\nWe
    are going to attack them at their outpost as we have originally planned, even
    though we don't know if we'll hold up for the last battle.\n\nMartin is calling,
    I have no time, there's so much I wanted to say... if anything goes wrong...
    take care brother, I will never forget you.\n\nYours, Vera."
  CantBeTaken: 0
  isNoteOrScroll: 1
